# ── TradeLab Environment Configuration ────────────────────────────────────
# Copy this file to .env and fill in your actual credentials.

# ── Gemini AI Configuration ──────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Angel One SmartAPI Credentials ────────────────────────────────────────
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# ── Google OAuth Credentials ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=518222337987-4gkeuho6suld8hbtml9hk4jopofurn35.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# ── Application Secrets & Database ───────────────────────────────────────
# DATABASE_URL defaults to the backend directory; set explicitly for PostgreSQL.
JWT_SECRET_KEY=
VIRTUAL_STARTING_CAPITAL=1000000.0

# ── Render Always-On Keep-Alive ──────────────────────────────────────────
# On Render, RENDER_EXTERNAL_URL is set automatically by the platform.
# For custom domains, set KEEP_ALIVE_URL=https://your-domain.com/api/health
KEEP_ALIVE_INTERVAL_SECONDS=600
ENABLE_KEEP_ALIVE=true

# ── Testing switch ──────────────────────────────────────────────────────
# true = allow opening paper trades outside 09:15-15:15 IST and disable the 15:15 auto square-off
# (prices are then the last traded ones). Leave false for realistic intraday behaviour.
ALLOW_OFFHOURS_TRADING=false

# Explicit opt-in for offline development only.
ALLOW_SIMULATED_TRADING=false

# Adaptive memory / automatic paper-trade risk rules
MEMORY_SHORT_DAYS=5
MEMORY_LONG_DAYS=30
AUTO_MAX_DAILY_TRADES=5
AUTO_REPEAT_STRIKE_COOLDOWN_MINUTES=30
AUTO_TREND_THRESHOLD_PCT=0.75

# Comma-separated officially verified exchange closure dates (YYYY-MM-DD); keep updated.
EXCHANGE_HOLIDAYS=
# Optional comma-separated special trading sessions: YYYY-MM-DD=HH:MM-HH:MM
EXCHANGE_SPECIAL_SESSIONS=
# Set false to restrict simulator to long-only BUY option entries (recommended when clearing margin API unavailable)
ALLOW_SHORT_OPTIONS=true

# V5 quantitative paper-trading filters (experimental, not calibrated probabilities)
MEMORY_EXTENDED_DAYS=90
QUANT_MIN_CONFIDENCE=8
QUANT_MIN_NET_RR=1.5
QUANT_MAX_SPREAD_PCT=2.0
QUANT_MAX_VERDICT_AGE_SECONDS=180
